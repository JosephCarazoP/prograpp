rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar para comprobar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Función auxiliar para comprobar si el usuario es el dueño del documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Administrador oficial verificado
    function isAdmin() {
      return isAuthenticated() 
        && request.auth.token.email == 'josephcarazo56@gmail.com';
    }

    // Configuración criptográfica de contraseña administrativa (Solo admin)
    match /adminConfig/security {
      allow read, write: if isAdmin();
    }

    // Perfil privado del usuario / estudiante
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Estudiante puede crear su perfil pero nunca asignarse investigación por su cuenta
      allow create: if isOwner(userId) 
        && (!('isResearchParticipant' in request.resource.data) || request.resource.data.isResearchParticipant == false);
      // Estudiante no puede auto-otorgarse condición de participante de investigación
      allow update: if (isOwner(userId) 
        && (!('isResearchParticipant' in request.resource.data) || request.resource.data.isResearchParticipant == resource.data.isResearchParticipant))
        || isAdmin();
      allow delete: if false;

      // Progreso por lección (ej: /users/{userId}/progress/{lessonId})
      match /progress/{lessonDocId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // Historial inmutable de intentos por estudiante
      match /attempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if false; // Inmutabilidad estricta
      }

      // Registro de días activos para racha
      match /activityDays/{dayId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if false;
      }

      // Misiones diarias
      match /dailyQuests/{questId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Evaluaciones estandarizadas (Diagnóstico y Prueba Final)
    match /evaluations/{evalId} {
      allow read: if (isAuthenticated() && resource.data.studentId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAdmin(); // Solo el docente califica preguntas abiertas o edita notas
      allow delete: if false;
    }

    // Observaciones docentes (Exclusivo para el administrador)
    match /observations/{obsId} {
      allow read, write: if isAdmin();
    }

    // Opiniones breves de actividades (Estudiante crea, solo admin lee)
    match /studentFeedback/{feedId} {
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Perfiles públicos compartibles
    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // Ligas y clasificaciones semanales
    match /leagues/{leagueId}/members/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
  }
}
