# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Si está en true o no hay claves configuradas, la app usa automáticamente persistencia local (IndexedDB/Mock)
VITE_USE_LOCAL_MOCK=true

# Firebase Admin Service Account (Para Vercel / Backend: eliminación permanente de estudiantes en Authentication)
# Generar en Firebase Console -> Configuración del proyecto -> Cuentas de servicio -> Generar nueva clave privada
# Puede ser el contenido JSON en una sola línea o en base64
FIREBASE_SERVICE_ACCOUNT_KEY=
